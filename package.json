{
    "name": "@scratch-fuse/core",
    "version": "1.0.0",
    "description": "The core of fuse language",
    "keywords": [
        "blocks",
        "fuse",
        "parser",
        "scratch",
        "script"
    ],
    "homepage": "https://github.com/scratch-fuse/core#readme",
    "bugs": {
